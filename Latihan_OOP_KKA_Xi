        "from abc import ABC, abstractmethod\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# ABSTRACT CLASS\n",
        "# =========================================================\n",
        "\n",
        "class KamarHotel(ABC):\n",
        "    def __init__(self, nama_kamar, stok, harga_dasar):\n",
        "        self.nama_kamar = nama_kamar\n",
        "        self.__stok = 0\n",
        "        self.__harga_dasar = harga_dasar\n",
        "\n",
        "        # Menggunakan setter untuk validasi stok awal\n",
        "        self.tambah_stok(stok)\n",
        "\n",
        "    # Getter stok\n",
        "    def get_stok(self):\n",
        "        return self.__stok\n",
        "\n",
        "    # Getter harga dasar\n",
        "    def get_harga_dasar(self):\n",
        "        return self.__harga_dasar\n",
        "\n",
        "    # Method untuk menambah/mengubah stok\n",
        "    def tambah_stok(self, jumlah):\n",
        "        if self.__stok + jumlah < 0:\n",
        "            print(\n",
        "                f\"Gagal update stok {self.nama_kamar}! \"\n",
        "                f\"Stok tidak boleh negatif ({jumlah}).\"\n",
        "            )\n",
        "        else:\n",
        "            self.__stok += jumlah\n",
        "\n",
        "    # Abstract method\n",
        "    @abstractmethod\n",
        "    def tampilkan_detail(self):\n",
        "        pass\n",
        "\n",
        "    @abstractmethod\n",
        "    def hitung_harga_total(self, jumlah_malam):\n",
        "        pass\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# CHILD CLASS: KAMAR DELUXE\n",
        "# =========================================================\n",
        "\n",
        "class KamarDeluxe(KamarHotel):\n",
        "\n",
        "    def __init__(self, nama_kamar, stok, harga_dasar, fasilitas):\n",
        "        super().__init__(nama_kamar, stok, harga_dasar)\n",
        "        self.fasilitas = fasilitas\n",
        "\n",
        "    # Polymorphism / Override\n",
        "    def tampilkan_detail(self):\n",
        "        pajak = self.get_harga_dasar() * 10 / 100\n",
        "\n",
        "        print(\n",
        "            f\"[DELUXE] {self.nama_kamar} | \"\n",
